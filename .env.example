# =====================================================================================
# audit-service — environment variables (generated from application*.yml; keep in sync)
#
#   cp .env.example .env        then uncomment ONLY what you need to change.
#
# Precedence, highest first: real environment variables > ./.env > ../platform.env >
# the defaults in application*.yml (shown below). A commented line keeps its default.
# NEVER write an empty value (VAR=): an empty value REPLACES the default with "".
# No inline comments: in this format '#' starts a comment only at the start of a line.
# .env is git-ignored; never commit real values. See docs/configuration in the platform docs.
# =====================================================================================

# ---- Profile -------------------------------------------------------------------------------
# Path of the shared platform.env (default ../platform.env, relative to the working directory).
# APARGO_PLATFORM_ENV=../platform.env

# ---- Shared infrastructure — normally set ONCE in ../platform.env; set here only to override for this service ---
# Kafka brokers, host:port[,host:port].
# KAFKA_BOOTSTRAP_SERVERS=146.88.24.113:9092
# AUDIT_SERVICE_PORT=8070
# Eureka server URL.
# EUREKA_DEFAULT_ZONE=http://146.88.24.113:8761/eureka/

# ---- Other secrets (this service only) -----------------------------------------------------
# AUDIT_MONGO_WRITE_URI=<secret>
# AUDIT_MONGO_READ_URI=<secret>
# AUDIT_INTERNAL_API_KEY=<secret>

# ---- Service settings ----------------------------------------------------------------------
# SPRING_APPLICATION_NAME=audit-service
# SHUTDOWN_TIMEOUT=30s
# KAFKA_CLIENT_ID=audit-service
# AUDIT_BATCH_MAX_RECORDS=500
# AUDIT_BATCH_MIN_BYTES=262144
# AUDIT_BATCH_MAX_WAIT=500ms
# KAFKA_MAX_PARTITION_FETCH_BYTES=1048576
# KAFKA_FETCH_MAX_BYTES=8388608
# KAFKA_MAX_POLL_INTERVAL_MS=300000
# KAFKA_DELIVERY_TIMEOUT_MS=30000
# KAFKA_MAX_BLOCK_MS=10000
# HTTP port for this service only; normally the port comes from <NAME>_SERVICE_PORT in ../platform.env.
# SERVER_PORT=8070
# TOMCAT_MAX_THREADS=100
# development | staging | production (the audit service dead-letters a mismatch).
#   (prod profile default: production)
# AUDIT_ENVIRONMENT=development
# AUDIT_ROLE_CONSUMER=true
# AUDIT_ROLE_API=true
# AUDIT_ROLE_ARCHIVER=false
# AUDIT_TOPIC=apargo.audit.events
# ACCESS_TOPIC=apargo.access.events
# DLQ_SUFFIX=.dlq
# AUDIT_CONSUMER_GROUP=audit-service.audit
# AUDIT_CONSUMER_CONCURRENCY=3
# ACCESS_CONSUMER_GROUP=audit-service.access
# ACCESS_CONSUMER_CONCURRENCY=2
# AUDIT_MAX_EVENT_BYTES=65536
# AUDIT_SUPPORTED_SCHEMA_VERSIONS=1
# AUDIT_MAX_FUTURE_SKEW=24h
# AUDIT_RETRY_INITIAL=1s
# AUDIT_RETRY_MULTIPLIER=2.0
# AUDIT_RETRY_MAX=60s
# AUDIT_CB_FAILURE_THRESHOLD=5
# AUDIT_CB_OPEN_DURATION=10s
# AUDIT_DLQ_SEND_TIMEOUT=15s
# AUDIT_MONGO_DATABASE=audit
# AUDIT_MONGO_WRITE_TIMEOUT=10s
# AUDIT_MONGO_QUERY_MAX_TIME=3s
# AUDIT_MONGO_MAX_STALENESS=90s
# AUDIT_MONGO_WRITE_POOL_SIZE=20
# AUDIT_MONGO_READ_POOL_SIZE=30
# AUDIT_MONGO_MANAGE_SCHEMA=true
# AUDIT_MONGO_BLOCK_COMPRESSOR=none
# AUDIT_HOT_DAYS=30
# ACCESS_HOT_DAYS=30
# AUDIT_QUERY_DEFAULT_RANGE=7d
# AUDIT_QUERY_MAX_RANGE=31d
# AUDIT_QUERY_DEFAULT_PAGE_SIZE=20
# AUDIT_QUERY_MAX_PAGE_SIZE=100
# AUDIT_MAX_STATS_BUCKETS=1000
# AUDIT_ARCHIVER_CRON=0 15 * * * *
# AUDIT_ARCHIVER_BATCH_SIZE=5000
# AUDIT_ARCHIVER_DELETE_CHUNK=1000
# AUDIT_ARCHIVER_DELETE_PAUSE=200ms
# AUDIT_ARCHIVER_MAX_RUN=45m
#   (dev profile default: LOCAL)
# AUDIT_ARCHIVE_STORE=NONE
#   (dev profile default: ./build/archive)
# AUDIT_ARCHIVE_LOCAL_DIR=./archive
# AUDIT_INTERNAL_ALLOWED_CALLERS=*
# AUDIT_CORS_ALLOWED_ORIGINS=*
# Comma-separated browser origins; * = any.
# CORS_ALLOWED_ORIGINS=*
# Actuator endpoints exposed over HTTP, comma-separated.
# MANAGEMENT_ENDPOINTS=health,info,prometheus
# Health details: never | when-authorized | always.
#   (dev profile default: always)
# MANAGEMENT_HEALTH_DETAILS=never
# Serve OpenAPI docs and Swagger UI.
#   (prod profile default: false)
# SWAGGER_ENABLED=true
# Register with Eureka.
# EUREKA_ENABLED=true
# Register this instance in Eureka.
# EUREKA_REGISTER_WITH_EUREKA=true
# Fetch the Eureka registry.
# EUREKA_FETCH_REGISTRY=true
# Register with the IP address instead of the hostname.
# EUREKA_PREFER_IP_ADDRESS=true
# Root log level.
# LOG_LEVEL_ROOT=INFO
# Log level of this service's own packages.
#   (dev profile default: DEBUG)
# LOG_LEVEL_APP=INFO
# LOG_LEVEL_KAFKA=WARN
# LOG_LEVEL_MONGO=WARN
# LOG_FORMAT=ecs

# ---- Older names — still honoured as fallbacks, use the new name instead -------------------
# SERVER_MAX_THREADS  ->  use TOMCAT_MAX_THREADS
# API_DOCS_ENABLED  ->  use SWAGGER_ENABLED
# EUREKA_URL  ->  use EUREKA_DEFAULT_ZONE
# AUDIT_LOG_LEVEL  ->  use LOG_LEVEL_APP
